# A1s environment contract:
#   - Process vars use the A1S_ prefix (A1S_DSN, A1S_API_URL, ...).
#   - Airway framework vars (AIRWAY_ENV, AIRWAY_PORT, URL_PREFIX,
#     STORAGE_*) keep their framework names.
# Copy to .env and trim to what you need. godotenv never overrides vars
# already set in the process environment, so real env vars win over .env.

# ---------------------------------------------------------------------------
# All processes
# ---------------------------------------------------------------------------

# Runtime environment: local | production (Airway framework var)
AIRWAY_ENV="production"

# Timezone
TZ="Asia/Shanghai"

# ---------------------------------------------------------------------------
# a1s api — HTTP control plane
# ---------------------------------------------------------------------------

# PostgreSQL DSN holding all system state. The Airway CLI commands compiled
# into the binary (db:migrate, db:rollback, repl, ...) read the same value.
# A1S_DSN="postgres://a1s:a1s@127.0.0.1:5432/a1s?sslmode=disable"

# Optional Redis URL used by Airway framework features.
# A1S_REDIS="redis://127.0.0.1:6379/0"

# Listen port (Airway framework var)
AIRWAY_PORT="1905"

# Optional sub-path prefix when deployed behind a proxy,
# e.g. http://host/a1s/...
# URL_PREFIX="/a1s"

# File storage, set up at api boot (Airway framework vars).
# Driver: local | s3 | r2 | cos
STORAGE_DRIVER="local"

# Local storage root dir (driver=local)
STORAGE_ROOT="./data/storage"

# Cloud object storage (driver=s3|r2|cos)
# STORAGE_REGION=""
# STORAGE_ENDPOINT=""   # optional endpoint override; required for r2
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# Public base URL (e.g. CDN). When set, file URLs are built from it instead
# of presigned URLs.
# STORAGE_PUBLIC_URL=""

# ---------------------------------------------------------------------------
# a1s worker (Phase 3)
# ---------------------------------------------------------------------------

# Control plane API base URL the worker talks to.
# A1S_API_URL="http://127.0.0.1:1905"

# Shared bearer token for internal worker/API endpoints.
# A1S_INTERNAL_TOKEN=""

# Heartbeat interval.
# A1S_HEARTBEAT_INTERVAL="5s"

# ---------------------------------------------------------------------------
# a1s scheduler (Phase 4)
# ---------------------------------------------------------------------------

# Poll interval for pending containers.
# A1S_SCHEDULER_INTERVAL="3s"

# ---------------------------------------------------------------------------
# a1s monitor (Phase 5)
# ---------------------------------------------------------------------------

# Heartbeat timeout before a worker is marked lost.
# A1S_HEARTBEAT_TIMEOUT="15s"
